<Window x:Class="Inclass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inclass"
        mc:Ignorable="d"
        Title="Tic Tac Toe" 
        Height="450" MinHeight="350"
        Width="800" MinWidth="600"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
     >
    <!-- Name: Nevyle Chinda | Date: October 2, 2026 | Description: Tic Tac Toe game window layout. -->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button x:Name="btn00" Content="" Grid.Row="2" FontSize="48" TabIndex="4" ToolTip="Click to make a play"/>
        <Button x:Name="btn01" Grid.Column="1" Content="" Grid.Row="2" FontSize="48" TabIndex="5" ToolTip="Click to make a play"/>
        <Button x:Name="btn02" Grid.Column="2" Content="" Grid.Row="2" FontSize="48" TabIndex="6" ToolTip="Click to make a play"/>
        <Button x:Name="btn10" Content="" Margin="0,86,0,0" Grid.Row="2" Grid.RowSpan="2" FontSize="48" TabIndex="7" ToolTip="Click to make a play"/>
        <Button x:Name="btn11" Grid.Column="1" Content="" Margin="0,86,0,0" Grid.Row="2" Grid.RowSpan="2" FontSize="48" TabIndex="8" ToolTip="Click to make a play"/>
        <Button x:Name="btn12" Grid.Column="2" Content="" Margin="0,86,0,0" Grid.Row="2" Grid.RowSpan="2" FontSize="48" TabIndex="9" ToolTip="Click to make a play"/>
        <Button x:Name="btn20" Content="" Margin="0,87,0,0" Grid.Row="3" Grid.RowSpan="2" FontSize="48" TabIndex="10" ToolTip="Click to make a play"/>
        <Button x:Name="btn21" Grid.Column="1" Content="" Margin="0,87,0,0" Grid.Row="3" Grid.RowSpan="2" FontSize="48" TabIndex="11" ToolTip="Click to make a play"/>
        <Button x:Name="btn22" Grid.Column="2" Content="" Margin="0,87,0,0" Grid.Row="3" Grid.RowSpan="2" FontSize="48" TabIndex="12" ToolTip="Click to make a play"/>
        <Button x:Name="btnReset" Grid.Column="3" Content="_Reset" Background="White" HorizontalAlignment="Left" Margin="60,87,0,0" Grid.Row="3" VerticalAlignment="Top" RenderTransformOrigin="5.025,-1.761" Height="34" Width="60" Grid.RowSpan="2" TabIndex="13" ToolTip="Clears the board and resets all scores"/>
        <Button x:Name="btnExit" Grid.Column="3" Content="E_xit" Background="White" HorizontalAlignment="Left" Margin="60,44,0,0" Grid.Row="4" VerticalAlignment="Top" RenderTransformOrigin="-0.557,0.563" Width="60" Height="33" TabIndex="14" ToolTip="Exits the application"/>
        <Label Content="Tic Tac Toe" FontFamily="Segoe UI Semibold" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" Margin="42,10,0,0" VerticalAlignment="Top"/>
        <Label Content="X Player" FontWeight="Bold" HorizontalAlignment="Left" Margin="10,43,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.286,1.303" Height="26"/>
        <Label Grid.Column="1" Content="O Player" FontWeight="Bold"  HorizontalAlignment="Left" Margin="10,43,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.496,0.067"/>
        <TextBox x:Name="txtOPlayer" HorizontalAlignment="Left" Margin="72,47,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TabIndex="1" Grid.Column="1" ToolTip="Enter Player name 2"/>
        <TextBox x:Name="txtXPlayer" HorizontalAlignment="Left" Margin="70,46,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TabIndex="0" ToolTip="Enter Player name 1"/>
        <Button x:Name="btnChooseStart" Content="Choose Starting Player" Background="WhiteSmoke"   HorizontalAlignment="Center" Margin="0,23,0,0" Grid.Row="1" VerticalAlignment="Top" Width="124" Height="59" TabIndex="2" ToolTip="Choose which player starts first"/>
        <Label Grid.Column="1" Content="Current Player" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="1" VerticalAlignment="Top" RenderTransformOrigin="1.093,0.508"/>
        <TextBox x:Name="txtCurrentPlayer" Grid.Column="1" HorizontalAlignment="Left" Margin="61,53,0,0" Grid.Row="1" TextWrapping="Wrap" Text="X" VerticalAlignment="Top" Width="58" Height="29" RenderTransformOrigin="0.301,0.542" IsReadOnly="True" IsTabStop="False" TabIndex="3" ToolTip="Displays which player's turn it is to play"/>
        <Label Grid.Column="3" Content="Score" FontWeight="Bold" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top" RenderTransformOrigin="0.576,0.29" Height="26" Margin="71,0,0,0"/>
        <TextBox x:Name="txtXScore" Grid.Column="3" HorizontalAlignment="Left" Margin="112,26,0,0" Grid.Row="2" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="22" Height="17" IsReadOnly="True" IsTabStop="False" ToolTip="Player X score"/>
        <TextBox x:Name="txtOScore" Grid.Column="3" HorizontalAlignment="Left" Margin="112,48,0,0" Grid.Row="2" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="22" Height="17" IsReadOnly="True" IsTabStop="False" ToolTip="Player O score"/>
        <TextBox x:Name="txtCatsScore" Grid.Column="3" HorizontalAlignment="Left" Margin="112,69,0,0" Grid.Row="2" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="22" Height="17" IsReadOnly="True" IsTabStop="False" ToolTip="Tie between the players"/>
        <Label Grid.Row="2" Grid.Column="3" Content="X" FontSize="10" FontWeight="Bold" VerticalAlignment="Top" Height="22" Margin="60,21,121,0" RenderTransformOrigin="14.985,-4.628"  />
        <Label Grid.Row="2" Grid.Column="3" Content="O" FontSize="10" FontWeight="Bold" VerticalAlignment="Top" Height="21" Margin="60,43,121,0"  />
        <Label Grid.Row="2" Grid.Column="3" Content="Cats" FontSize="10" FontWeight="Bold" VerticalAlignment="Top" Height="22" Margin="60,64,102,0"  />

    </Grid>
</Window>